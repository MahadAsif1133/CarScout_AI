# ────────────────────────────────────────────────────────────────────────────
# GaadiScout — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit your real .env file to git.
# ────────────────────────────────────────────────────────────────────────────

# ── Groq API (free tier — get at console.groq.com) ───────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Model to use (llama-3.1-8b-instant is free and fast)
AGENT_MODEL=llama-3.1-8b-instant

# ── Telegram (create a bot with @BotFather on Telegram) ──────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your Chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Email — Gmail SMTP ────────────────────────────────────────────────────────
# Use a Gmail App Password (NOT your regular password):
# myaccount.google.com > Security > 2-Step Verification > App passwords
EMAIL_SENDER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_16_char_gmail_app_password
EMAIL_RECIPIENT=recipient_email@example.com

# ── Hugging Face (for model downloads, fine-tuning uploads) ──────────────────
# Get at huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# ── Prediction mode ──────────────────────────────────────────────────────────
# Options: auto | statistical | finetuned
# 'auto' uses fine-tuned if ./lora_adapter/ exists, otherwise statistical
# 'statistical' always uses median-based predictor (no GPU needed)
# 'finetuned' requires ./lora_adapter/ from train_model.py
PREDICTION_MODE=auto

# ── Base model for fine-tuning (train_model.py + predict.py) ─────────────────
BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# ── Pipeline settings ─────────────────────────────────────────────────────────
# Max pages to scrape per run (each page ≈ 24 listings)
SCRAPE_MAX_PAGES=5
# Also fetch each listing's detail page for richer data (slower)
SCRAPE_DETAILS=false
# Minimum % below predicted fair price to flag as a deal
DEAL_THRESHOLD=15.0
# Minimum agent score (1-10) to send alerts
AGENT_THRESHOLD=7
# Set to false to disable alert channels during testing
ENABLE_TELEGRAM=true
ENABLE_EMAIL=true

# ── Pipeline orchestration engine (optional) ──────────────────────────────────
# Options: legacy | langgraph (default: legacy)
PIPELINE_ENGINE=legacy

# ── LangSmith Tracing (optional — off by default) ─────────────────────────────
# Set LANGCHAIN_TRACING_V2=true and provide LANGCHAIN_API_KEY to trace LangGraph
# and LLM calls in LangSmith (smith.langchain.com). Leave false/empty for no-op.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=CarScout_AI
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── n8n Webhook Alerts (optional — off by default, for local runs) ────────────
# When set, deal alerts are POSTed to this webhook URL first; if unset or if the
# webhook fails, the pipeline falls back to direct Telegram + Email alerts.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── MongoDB Raw Listing Store (optional — off by default) ─────────────────────
# When MONGODB_URI is set, raw scraped listing JSON is upserted into MongoDB.
# SQLite remains the source of truth for cleaned data and the dashboard.
MONGODB_URI=
MONGODB_DB=carscout
MONGODB_COLLECTION=raw_listings
