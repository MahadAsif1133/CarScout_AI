{
  "name": "CarScout_AI Deal Alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "carscout-alerts",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b1c2d3e4-0001-4000-8000-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "carscout-alerts"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-secret-check",
              "leftValue": "={{ $json.headers['x-webhook-secret'] || '' }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET || '' }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1c2d3e4-0002-4000-8000-000000000002",
      "name": "Check Webhook Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚗 *CarScout_AI Deal Alert!*\n\n*{{ $json.body.title }}*\n💰 Listed: PKR {{ $json.body.price }}\n📊 Fair Value: PKR {{ $json.body.predicted_price }}\n📉 Below Market: {{ $json.body.price_gap_pct }}%\n🏆 Deal Score: {{ $json.body.deal_score }}/10\n📍 City: {{ $json.body.city }} | 🛣️ Mileage: {{ $json.body.mileage }} km\n⚠️ Risk Flags: {{ ($json.body.risk_flags || []).join(', ') || 'None' }}\n💬 Analysis: {{ $json.body.agent_summary }}\n\n🔗 {{ $json.body.listing_url }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "b1c2d3e4-0003-4000-8000-000000000003",
      "name": "Telegram Deal Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        740,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_SENDER }}",
        "toEmail": "={{ $env.EMAIL_RECIPIENT }}",
        "subject": "=🔥 CarScout_AI: {{ $json.body.title }} — {{ $json.body.price_gap_pct }}% below market (Score: {{ $json.body.deal_score }}/10)",
        "html": "=<h2>🚗 CarScout_AI Deal Alert: {{ $json.body.title }}</h2><p><strong>Listed Price:</strong> PKR {{ $json.body.price }}<br><strong>Predicted Fair Price:</strong> PKR {{ $json.body.predicted_price }}<br><strong>Discount:</strong> {{ $json.body.price_gap_pct }}% below market<br><strong>Deal Score:</strong> {{ $json.body.deal_score }}/10<br><strong>City:</strong> {{ $json.body.city }} | <strong>Mileage:</strong> {{ $json.body.mileage }} km<br><strong>Risk Flags:</strong> {{ ($json.body.risk_flags || []).join(', ') || 'None' }}</p><p><strong>AI Analysis:</strong> {{ $json.body.agent_summary }}</p><p><a href=\"{{ $json.body.listing_url }}\">View Listing on PakWheels</a></p>",
        "options": {}
      },
      "id": "b1c2d3e4-0004-4000-8000-000000000004",
      "name": "Send SMTP Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1000,
        200
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Check Webhook Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Webhook Secret": {
      "main": [
        [
          {
            "node": "Telegram Deal Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Deal Alert": {
      "main": [
        [
          {
            "node": "Send SMTP Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}
